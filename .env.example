# Server network binding configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Base URL prefix or specific route path
API_V1_PREFIX=/api/v1
STAMP_EXTRACT_PATH=/extract/stamp

# Vision model configuration (Hugging Face ID or local path on Ubuntu)
MODEL_ID=Qwen/Qwen2-VL-2B-Instruct
DEVICE=cpu
MAX_IMAGE_DIMENSION=1280

